rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminEmail() {
      return isAuthenticated() &&
        (request.auth.token.email.matches('.*@namastemart\\.com') ||
         request.auth.token.email == 'namaste.mart.admin@gmail.com');
    }

    function hasAdminRole() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function hasAdminAccess() {
      return isAdmin() || isAdminEmail() || hasAdminRole();
    }

    // ── PRODUCTS ──────────────────────────────────────────────────────────
    // Anyone can read public / non-hidden products; only admins can write
    match /products/{productId} {
      allow read: if !resource.data.isHidden ||
                     (isAuthenticated() && hasAdminAccess());
      allow create, delete: if hasAdminAccess();
      allow update: if hasAdminAccess() ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
                        request.resource.data.stock >= 0);
    }

    // ── CARTS ─────────────────────────────────────────────────────────────
    // Users can only access and modify their own cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── WISHLISTS ─────────────────────────────────────────────────────────
    // Users can only access and modify their own wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── ORDERS ────────────────────────────────────────────────────────────
    // Customers read/create their own orders; admins read/manage all orders
    match /orders/{orderId} {
      allow read: if hasAdminAccess() ||
                     (isAuthenticated() &&
                      (request.auth.uid == resource.data.customerUid ||
                       request.auth.uid == resource.data.userId));
      allow create: if isAuthenticated() &&
                       (request.resource.data.customerUid == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid);
      allow update: if hasAdminAccess() ||
                       (isAuthenticated() &&
                        (request.auth.uid == resource.data.customerUid ||
                         request.auth.uid == resource.data.userId) &&
                        (
                          (request.resource.data.status == 'CANCELLED' ||
                           request.resource.data.status == 'cancelled') ||
                          (request.resource.data.payment.verified == false &&
                           request.resource.data.payment.verifiedBy == null &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment', 'paymentScreenshot', 'status', 'updatedAt']))
                        ));
      allow delete: if hasAdminAccess();
    }

    // ── REVIEWS ───────────────────────────────────────────────────────────
    // Anyone can read; authenticated users can write their own reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || hasAdminAccess();
    }

    // ── CATEGORIES ────────────────────────────────────────────────────────
    // Anyone reads categories; only admins manage
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if hasAdminAccess();
    }

    // ── BANNERS ───────────────────────────────────────────────────────────
    // Anyone reads banners; only admins manage
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if hasAdminAccess();
    }

    // ── USERS ────────────────────────────────────────────────────────────
    // Users read/write only their own document & addresses subcollection; admins read all
    match /users/{userId} {
      allow read: if isOwner(userId) || hasAdminAccess();
      allow write: if isOwner(userId) || hasAdminAccess();

      match /addresses/{addressId} {
        allow read: if isOwner(userId) || hasAdminAccess();
        allow write: if isOwner(userId) || hasAdminAccess();
      }
    }

    // ── ADMINS ────────────────────────────────────────────────────────────
    // Only existing admins can manage the admin list
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminAccess();
    }

    // ── ANALYTICS ─────────────────────────────────────────────────────────
    // Only admins can read/write analytics
    match /analytics/{docId} {
      allow read, write: if hasAdminAccess();
    }

    // ── PARCELS ────────────────────────────────────────────────────────────
    // Admins manage parcels; customers can read their own shipment parcels
    match /parcels/{parcelId} {
      allow read: if hasAdminAccess() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if hasAdminAccess();
    }
  }
}

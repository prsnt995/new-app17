rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminEmail() {
      return isAuthenticated() &&
        (request.auth.token.email.matches('.*@namastemart\\.com') ||
         request.auth.token.email == 'namaste.mart.admin@gmail.com');
    }

    function hasAdminAccess() {
      return isAdmin() || isAdminEmail();
    }

    // ── PRODUCTS ──────────────────────────────────────────────────────────
    // Anyone can read non-hidden products; only admins can write
    match /products/{productId} {
      allow read: if !resource.data.isHidden ||
                     (isAuthenticated() && hasAdminAccess());
      allow create, update, delete: if hasAdminAccess();
    }

    // ── ORDERS ────────────────────────────────────────────────────────────
    // Customers read/write their own orders; admins read/write all
    match /orders/{orderId} {
      allow read: if hasAdminAccess() ||
                     (isAuthenticated() && request.auth.uid == resource.data.customerUid);
      allow create: if isAuthenticated() &&
                       request.resource.data.customerUid == request.auth.uid;
      allow update: if hasAdminAccess() ||
                       (isAuthenticated() && request.auth.uid == resource.data.customerUid &&
                        // Customers can only cancel their own orders
                        request.resource.data.status == 'CANCELLED');
      allow delete: if hasAdminAccess();
    }

    // ── REVIEWS ───────────────────────────────────────────────────────────
    // Anyone can read; authenticated users can write their own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || hasAdminAccess();
    }

    // ── CATEGORIES ────────────────────────────────────────────────────────
    // Anyone reads active categories; only admins manage
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if hasAdminAccess();
    }

    // ── BANNERS ───────────────────────────────────────────────────────────
    // Anyone reads active banners; only admins manage
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if hasAdminAccess();
    }

    // ── USERS ────────────────────────────────────────────────────────────
    // Users read/write only their own document; admins read all
    match /users/{userId} {
      allow read: if isOwner(userId) || hasAdminAccess();
      allow write: if isOwner(userId);
    }

    // ── ADMINS ────────────────────────────────────────────────────────────
    // Only existing admins can manage the admin list
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminAccess();
    }

    // ── ANALYTICS ─────────────────────────────────────────────────────────
    // Only admins can read/write analytics summaries
    match /analytics/{docId} {
      allow read, write: if hasAdminAccess();
    }
  }
}
